# ---- RallyPoint environment template ----
# Copy to .env and fill in. Never commit real secrets.

# Core
NODE_ENV=development
PORT=3001
APP_URL=https://app.rallypoint.example
VITE_API_URL=http://localhost:3001/api/v1

# Frontend
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Database & cache
DATABASE_URL=postgres://rallypoint:CHANGE_ME@localhost:5432/rallypoint
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SIGNING_KEY=CHANGE_ME_rotate_regularly
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=12

# Identity verification (KYC provider)
KYC_PROVIDER_API_KEY=CHANGE_ME
KYC_WEBHOOK_SECRET=CHANGE_ME
KYC_NAME_MATCH_THRESHOLD=0.72
KYC_DOC_RETENTION_DAYS=30

# Secure object storage (isolated bucket, signed URLs only)
STORAGE_BUCKET=rallypoint-private-uploads
STORAGE_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=300

# Providers (abstracted)
MAP_PROVIDER=osm            # google | mapbox | osm
MAP_API_KEY=
WEATHER_API_KEY=            # optional — outdoor event rain risk
PAYMENT_PROVIDER=none       # none | stripe — raw card data never stored locally

# Anti-abuse
RATE_LIMIT_REGISTRATION_PER_HOUR=5
RATE_LIMIT_CODE_RESENDS=3
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
