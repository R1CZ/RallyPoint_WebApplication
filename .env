# RallyPoint Development Environment
# Copy from .env.example and customize as needed

# Core
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001/api/v1

# Frontend
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Backend
JWT_SECRET=rallypoint-dev-secret-change-in-production-abc123xyz
CORS_ORIGIN=http://localhost:5173

# Database (SQLite - auto-created in server/data/)
# No configuration needed for SQLite

# Identity verification (mock for development)
KYC_PROVIDER_API_KEY=mock
KYC_WEBHOOK_SECRET=mock
KYC_NAME_MATCH_THRESHOLD=0.72
KYC_DOC_RETENTION_DAYS=30

# Secure object storage (mock for development)
STORAGE_BUCKET=mock
STORAGE_REGION=mock
SIGNED_URL_TTL_SECONDS=300

# Providers (mock for development)
MAP_PROVIDER=osm
MAP_API_KEY=
WEATHER_API_KEY=
PAYMENT_PROVIDER=mock

# Anti-abuse
RATE_LIMIT_REGISTRATION_PER_HOUR=5
RATE_LIMIT_CODE_RESENDS=3
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
